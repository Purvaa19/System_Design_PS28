# ==============================================================================
# PS 28 Distributed Systems Virtual Lab — Frontend Configuration
# ==============================================================================
# In Netlify (Site settings > Environment variables) or local `.env.local`,
# configure the two output URLs from your deployed CloudFormation stack:
# (Stack: system-design-virtuallab in us-east-1)
#
# 1. HttpApiUrl      -> VITE_AWS_API_URL
# 2. WebSocketApiUrl  -> VITE_AWS_WS_URL
# ==============================================================================

VITE_AWS_API_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
VITE_AWS_WS_URL=wss://yyyyyyyyyy.execute-api.us-east-1.amazonaws.com/prod

# ==============================================================================
# STRICT SECURITY MANDATE:
# Never set VITE_AWS_ADMIN_KEY in Netlify, Git, or .env!
# Vite compiles all VITE_* variables into public browser JavaScript bundles.
# The AdminApiKey must ONLY be entered by the user at runtime via the in-app
# authorization prompt. It is kept strictly in volatile RAM for the active session.
# ==============================================================================
